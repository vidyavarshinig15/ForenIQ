        {
          "canonical_id": "c1010000-0000-0000-0000-000000000001",
          "evidence_id": "e1010000-0000-0000-0000-000000000001",
          "artifact_type": "message",
          "source_application": "WhatsApp",
          "timestamp": "2026-09-15T21:30:00Z",
          "sender": "+919876543210 (Rahul)",
          "receiver": "+919876543211 (Vikram)",
          "content": "Let's meet tomorrow at 10 PM near the warehouse."
        }
      ],
      "expected_insufficient": false,
      "expected_cited_ids": ["c1010000-0000-0000-0000-000000000001"],
      "expected_facts": ["warehouse", "10 PM", "Rahul", "Vikram"],
      "expected_conflicts": false
