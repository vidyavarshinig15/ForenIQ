# ==============================================================================
# AI-Driven Intelligent UFDR Analysis System - Environment Configuration
# ==============================================================================
# NOTE: This file is a template. Copy to .env and provide local values.
# NEVER commit .env files containing real secrets, tokens, or credentials.
# ==============================================================================

# Application Environment (Phase 1 Implemented)
APP_ENV=development                    # development | staging | production | test
APP_NAME="AI-Driven Intelligent UFDR Analysis System"
APP_VERSION=0.2.0
APP_PORT=8000
APP_HOST=0.0.0.0
API_PREFIX=/api/v1
DEBUG=True
LOG_LEVEL=INFO                         # DEBUG | INFO | WARNING | ERROR

# Bootstrap Administrator (Initial creation on first startup)
INITIAL_ADMIN_EMAIL=admin@ufdr.org
INITIAL_ADMIN_PASSWORD=ForensicAdmin2026!
INITIAL_ADMIN_NAME="Forensic System Administrator"

# CORS Allowed Origins (Comma-separated list or JSON array)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000,http://127.0.0.1:5173

# Frontend API URL (Used during frontend build/dev)
VITE_API_URL=/api/v1

# Security & Cryptography (Phase 2 Planning)
SECRET_KEY=replace_with_strong_secret_key_minimum_32_characters_long
JWT_SECRET=dev_secret_replace_in_production_with_high_entropy_key
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Relational Database (PostgreSQL - Phase 2 Planning)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=ufdr_forensics
POSTGRES_USER=ufdr_admin
POSTGRES_PASSWORD=replace_with_secure_postgres_password
DATABASE_URL=postgresql+asyncpg://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}

# Document Database (MongoDB - Phase 3 Planning)
MONGODB_HOST=localhost
MONGODB_PORT=27017
MONGODB_DB=ufdr_raw_artifacts
MONGODB_USER=ufdr_mongo_admin
MONGODB_PASSWORD=replace_with_secure_mongo_password
MONGODB_URI=mongodb://${MONGODB_USER}:${MONGODB_PASSWORD}@${MONGODB_HOST}:${MONGODB_PORT}/${MONGODB_DB}?authSource=admin

# Cache & Message Broker (Redis - Phase 3 Planning)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=replace_with_secure_redis_password
REDIS_DB=0
REDIS_URL=redis://:${REDIS_PASSWORD}@${REDIS_HOST}:${REDIS_PORT}/${REDIS_DB}

# Evidence Storage Paths & Limits (Phase 3 Planning)
EVIDENCE_STORAGE_PATH=./storage/evidence
SCRATCH_STORAGE_PATH=./storage/scratch
MAX_UPLOAD_SIZE_BYTES=107374182400     # 100 GB maximum archive upload
MAX_EXTRACTION_SIZE_BYTES=536870912000 # 500 GB maximum uncompressed extracted footprint

# Background Worker Settings (Phase 3 Planning)
WORKER_CONCURRENCY=4
WORKER_PREFETCH_MULTIPLIER=1
BATCH_INSERT_SIZE=1000

# AI / Semantic Search Configuration (Phase 4+ Planning)
LLM_PROVIDER=local                     # local | openai | anthropic | azure
LLM_API_KEY=replace_with_provider_api_key_if_applicable
LLM_MODEL_NAME=gpt-4o-mini             # Or local model identifier
EMBEDDING_MODEL_NAME=all-MiniLM-L6-v2  # Sentence-BERT embedding model
VECTOR_INDEX_PATH=./storage/vector_index
VECTOR_SIMILARITY_THRESHOLD=0.65

# Search Engine (OpenSearch / Elasticsearch - Phase 4 Planning)
SEARCH_ENGINE_URL=http://localhost:9200
SEARCH_INDEX_PREFIX=ufdr_case_
