# ==============================================================================
# ForenIQ — AI-Driven Intelligent UFDR Analysis System
# Master Environment Configuration Template (.env.example)
# ==============================================================================
# INSTRUCTIONS:
# 1. Copy this file to .env in your root directory: cp .env.example .env
# 2. Fill in local configuration values.
# 3. NEVER commit your actual .env file or real secrets to Git.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. APPLICATION & SERVER RUNTIME
# ------------------------------------------------------------------------------
APP_ENV=development                     # development | staging | production | test
APP_NAME="AI-Driven Intelligent UFDR Analysis System"
APP_VERSION=0.2.0
DEBUG=False                             # Set to True for interactive API docs in dev
LOG_LEVEL=INFO                          # DEBUG | INFO | WARNING | ERROR
HOST=0.0.0.0
PORT=8000

# CORS Allowed Origins (Comma-separated list or JSON array)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000,http://127.0.0.1:5173

# Frontend API URL (Used during Vite build/development)
VITE_API_URL=/api/v1

# ------------------------------------------------------------------------------
# 2. SECURITY & AUTHENTICATION (CRITICAL)
# ------------------------------------------------------------------------------
# High-entropy JWT signing key (minimum 32 characters, generate with: openssl rand -hex 32)
JWT_SECRET=change_me_to_a_secure_random_32_plus_char_secret_key
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Initial Bootstrap Administrator (Created on first system startup)
INITIAL_ADMIN_EMAIL=admin@ufdr.org
INITIAL_ADMIN_PASSWORD=change_me_to_a_strong_initial_password
INITIAL_ADMIN_NAME="Forensic System Administrator"

# Brute Force Protection
MAX_FAILED_LOGIN_ATTEMPTS=5
LOCKOUT_DURATION_MINUTES=15

# ------------------------------------------------------------------------------
# 3. DATABASE CONFIGURATION
# ------------------------------------------------------------------------------
# Default: Asynchronous SQLite (Zero-setup local development & testing)
DATABASE_URL=sqlite+aiosqlite:///./storage/ufdr_forensics.db

# Production Alternative: Asynchronous PostgreSQL
# DATABASE_URL=postgresql+asyncpg://ufdr_user:your_secure_password@localhost:5432/ufdr_forensics

DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30

# ------------------------------------------------------------------------------
# 4. QUEUE & BACKGROUND WORKERS
# ------------------------------------------------------------------------------
QUEUE_BACKEND=auto                      # auto (tries Redis, falls back to DB) | database | redis
REDIS_URL=redis://localhost:6379/0      # Optional: used only if Redis is running
WORKER_CONCURRENCY=2                    # Bounded worker concurrency
MAX_WORKERS=4
MAX_CONCURRENT_JOBS=4
JOB_LEASE_TIMEOUT_SECONDS=30
MAX_JOB_RETRIES=3

# ------------------------------------------------------------------------------
# 5. EVIDENCE STORAGE & SAFETY LIMITS
# ------------------------------------------------------------------------------
STORAGE_BACKEND=local
EVIDENCE_STORAGE_PATH=./storage/evidence
SCRATCH_STORAGE_PATH=./storage/scratch
MAX_UPLOAD_SIZE_MB=1024                 # 1 GB upload limit
MAX_ARCHIVE_ENTRIES=50000
MAX_TOTAL_UNCOMPRESSED_SIZE_MB=10240    # 10 GB uncompressed extraction limit
MAX_COMPRESSION_RATIO=100.0             # ZipBomb detection threshold
MAX_ARCHIVE_DEPTH=2

# ------------------------------------------------------------------------------
# 6. AI EMBEDDINGS & VECTOR INDEX (Phase 10)
# ------------------------------------------------------------------------------
EMBEDDING_MODEL_NAME=all-MiniLM-L6-v2   # Local SentenceTransformers model
EMBEDDING_MODEL_VERSION=2.0.0
EMBEDDING_DIMENSION=384
EMBEDDING_BATCH_SIZE=64
EMBEDDING_DEVICE=cpu                    # cpu | cuda | mps | auto
VECTOR_INDEX_DIR=./storage/vector_indices
MAX_SEMANTIC_TOP_K=100
DEFAULT_SEMANTIC_WEIGHT=0.5
DEFAULT_LEXICAL_WEIGHT=0.5
EXACT_MATCH_BOOST=0.3

# ------------------------------------------------------------------------------
# 7. NLP QUERY UNDERSTANDING (Phase 11)
# ------------------------------------------------------------------------------
SPACY_MODEL_NAME=en_core_web_sm         # spaCy pipeline (auto-falls back to rule-based)
NLP_PARSER_VERSION=1.0.0
MAX_INVESTIGATION_QUERY_LENGTH=500
DEFAULT_INVESTIGATION_TOP_K=50

# ------------------------------------------------------------------------------
# 8. RAG & INVESTIGATOR ASSISTANT (Phase 12)
# ------------------------------------------------------------------------------
RAG_LLM_PROVIDER=local                  # local (100% offline deterministic) | openai_compatible | mock
RAG_LLM_MODEL=deterministic-forensic-rag-v1

# Optional: Configuration for local Ollama / vLLM / OpenAI-compatible server
# RAG_LLM_PROVIDER=openai_compatible
# RAG_LLM_MODEL=llama3.2:3b
# RAG_OPENAI_BASE_URL=http://localhost:11434/v1
# RAG_OPENAI_API_KEY=optional_key_or_none

# Privacy Air-Gap Guard: set to True ONLY if external cloud LLMs are explicitly permitted
RAG_ALLOW_EXTERNAL_APIS=False
RAG_TEMPERATURE=0.0
RAG_MAX_CONTEXT_RECORDS=15
RAG_MAX_OUTPUT_TOKENS=800

# ------------------------------------------------------------------------------
# 9. GRAPH, ANOMALY & REPORT GENERATION (Phases 13-15)
# ------------------------------------------------------------------------------
GRAPH_MAX_NODES=1000
GRAPH_MAX_EDGES=5000
GRAPH_DEFAULT_MAX_DEPTH=2
GRAPH_COMMUNITY_ALGORITHM=LOUVAIN

ANOMALY_DEFAULT_CONTAMINATION=0.05
ANOMALY_N_ESTIMATORS=100
ANOMALY_SCORE_THRESHOLD=0.65
ANOMALY_DEFAULT_WINDOW=15m

REPORT_MAX_TIMELINE_EVENTS=500
REPORT_MAX_FINDINGS=200
REPORT_STORAGE_DIR=./storage/reports
